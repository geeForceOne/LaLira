@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SettingsService Settings
@inject Texts T
@implements IDisposable

<div class="shell">
    <aside class="sidebar" aria-label="@T["Navigation"]">
        <a class="brand" href="">
            <BrandMark Size="30" />
            <span class="brand-name">@AppInfo.Name</span>
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="side-nav" aria-label="@T["Main"]">
                    <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="overview" /><span>@T["Overview"]</span></NavLink>
                    <NavLink href="recurring" ActiveClass="active"><Icon Name="repeat" /><span>@T["Recurring"]</span></NavLink>
                    <NavLink href="reports" ActiveClass="active"><Icon Name="mail" /><span>@T["Reports"]</span></NavLink>
                    <NavLink href="settings" ActiveClass="active"><Icon Name="settings" /><span>@T["Settings"]</span></NavLink>
                </nav>

                <AccountsNav @ref="_ui.AccountsNav" />

                <div class="side-foot">
                    <UserMenu Name="@AppClaimsPrincipalFactory.ShownName(context.User)" IsAdmin="@context.User.IsInRole(Roles.Admin)" Up="true" />
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="side-foot">
                    <a class="btn btn-ghost btn-sm" href="account/login">@T["Sign in"]</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </aside>

    <header class="topbar">
        <a class="brand" href="">
            <BrandMark Size="28" />
            <span class="brand-name">@AppInfo.Name</span>
        </a>
        <AuthorizeView>
            <Authorized>
                <UserMenu Name="@AppClaimsPrincipalFactory.ShownName(context.User)" IsAdmin="@context.User.IsInRole(Roles.Admin)" Compact="true" />
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-ghost btn-sm" href="account/login">@T["Sign in"]</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="main">
        <AuthorizeView>
            <WhatsNewBanner />
            <InstallHint />
        </AuthorizeView>
        <CascadingValue Value="_ui" IsFixed="true">
            @Body
        </CascadingValue>
    </main>

    <AuthorizeView>
        <nav class="tabbar" aria-label="@T["Main"]">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active"><Icon Name="overview" Size="22" />@T["Overview"]</NavLink>
            <NavLink href="recurring" ActiveClass="active"><Icon Name="repeat" Size="22" />@T["Recurring"]</NavLink>
            <NavLink href="reports" ActiveClass="active"><Icon Name="mail" Size="22" />@T["Reports"]</NavLink>
            <NavLink href="settings" ActiveClass="active"><Icon Name="settings" Size="22" />@T["Settings"]</NavLink>
        </nav>
    </AuthorizeView>
</div>

<ConfirmDialog @ref="_ui.Confirm" />
<PromptDialog @ref="_ui.Prompt" />
<Toast @ref="_ui.Toast" />

<div id="blazor-error-ui" data-nosnippet>
    @T["Something went wrong and the page stopped responding."]
    <a href="." class="reload">@T["Reload"]</a>
    <span class="dismiss">×</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private readonly AppUi _ui = new();

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // The first visit takes language, region format and time zone from the browser, then reloads
    // so the page uses them.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthState is null) return;
        var user = (await AuthState).User;
        if (user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value is not { } userId)
            return;
        if (await Settings.ExistsAsync(userId))
            return;
        try
        {
            var browser = await JS.InvokeAsync<string[]>("lalira.browserLocale");
            await Settings.InitializeFromBrowserAsync(userId, browser.ElementAtOrDefault(0), browser.ElementAtOrDefault(1));
            var s = await Settings.GetAsync(userId);
            if (s.Language != T.Language || s.RegionFormat != T.Format.Name)
                Nav.Refresh(forceReload: true);
        }
        catch (JSException)
        {
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
