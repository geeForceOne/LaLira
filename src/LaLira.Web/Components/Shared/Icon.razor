@* Line icons on a 24 px grid, drawn with the current text color. *@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "overview": <rect x="3" y="3" width="7" height="9" rx="1" /><rect x="14" y="3" width="7" height="5" rx="1" /><rect x="14" y="12" width="7" height="9" rx="1" /><rect x="3" y="16" width="7" height="5" rx="1" /> break;
        case "repeat": <path d="M17 2l3 3-3 3M4 11V9a4 4 0 0 1 4-4h12M7 22l-3-3 3-3M20 13v2a4 4 0 0 1-4 4H4" /> break;
        case "mail": <rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /> break;
        case "settings": <circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1" /> break;
        case "sliders": <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /> break;
        case "users": <circle cx="9" cy="8" r="3.5" /><path d="M3 20a6 6 0 0 1 12 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6 6 0 0 1 3 5.5" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /> break;
        case "archive": <rect x="3" y="4" width="18" height="5" rx="1" /><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4" /> break;
        case "file": <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4" /> break;
        case "logout": <path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 16l-4-4 4-4M6 12h10" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "minus": <path d="M5 12h14" /> break;
        case "edit": <path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4" /> break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-12M9 7V4h6v3" /> break;
        case "check": <path d="M5 12.5l4.5 4.5L19 7" /> break;
        case "x": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "left": <path d="M15 5l-7 7 7 7" /> break;
        case "right": <path d="M9 5l7 7-7 7" /> break;
        case "down": <path d="M5 9l7 7 7-7" /> break;
        case "up": <path d="M5 15l7-7 7 7" /> break;
        case "chevrons": <path d="M8 9l4-4 4 4M8 15l4 4 4-4" /> break;
        case "upload": <path d="M12 16V4M7 9l5-5 5 5M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" /> break;
        case "download": <path d="M12 4v12M7 11l5 5 5-5M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" /> break;
        case "more": <circle cx="5" cy="12" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="19" cy="12" r="1.2" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "calendar": <rect x="3" y="5" width="18" height="16" rx="1.5" /><path d="M3 10h18M8 3v4M16 3v4" /> break;
        case "pause": <path d="M9 5v14M15 5v14" /> break;
        case "play": <path d="M8 5v14l11-7z" /> break;
        case "send": <path d="M21 3L10 14M21 3l-7 18-4-7-7-4z" /> break;
        case "key": <circle cx="8" cy="15" r="4" /><path d="M11 12l9-9M17 6l3 3M14 9l2 2" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /> break;
        case "alert": <path d="M12 3l10 18H2zM12 10v5M12 18v.5" /> break;
        case "restore": <path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v5h5" /> break;
        case "copy": <rect x="8" y="8" width="12" height="12" rx="1.5" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /> break;
        @* Account icons (AccountIcons). *@
        case "bank": <path d="M3 9.5L12 4l9 5.5M5 10v7.5M9.7 10v7.5M14.3 10v7.5M19 10v7.5M3 20h18" /> break;
        case "tax": <path d="M12 2.5V5M6.5 10.5a5.5 5.5 0 0 1 11 0M4.5 10.5h15M7.5 13.5v4.5M12 13.5v4.5M16.5 13.5v4.5M4 20.5h16" /> break;
        case "piggy": <path d="M18.5 10.5c-.6-3-3.3-5-6.5-5-3.9 0-7 2.7-7 6 0 1.9 1 3.6 2.6 4.7V19h3v-1.8h3V19h3v-2.9c.9-.6 1.6-1.4 2-2.3H20v-3.3zM8.5 5.8L7.5 3.5M15 10.5h.01" /> break;
        case "card": <rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3 10h18M7 14.5h4" /> break;
        case "coin": <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /> break;
        case "house": <path d="M3 11l9-7 9 7M5.5 9.5V20h13V9.5M10 20v-5.5h4V20" /> break;
        case "car": <path d="M4 15l1.6-4.8A2 2 0 0 1 7.5 8.8h9a2 2 0 0 1 1.9 1.4L20 15M3.5 15h17v3.5h-17zM6 18.5v1.5M18 18.5v1.5" /><circle cx="7.5" cy="16.8" r=".6" /><circle cx="16.5" cy="16.8" r=".6" /> break;
        case "chart": <path d="M4 4v16h16M8 15l3.5-4.5 3 2.5L19 7" /> break;
        case "umbrella": <path d="M3 12a9 9 0 0 1 18 0zM12 12v6.5a2 2 0 0 1-4 0M12 3v.5" /> break;
        case "briefcase": <rect x="3" y="7" width="18" height="13" rx="1.5" /><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18" /> break;
        case "cart": <path d="M3 4h2l2.4 11.5h11L21 8H6.3" /><circle cx="9" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /> break;
        case "plane": <path d="M21 15.5l-8-4.5V5a1.5 1.5 0 0 0-3 0v6l-8 4.5v2l8-2.5v4l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-4l8 2.5z" /> break;
        case "cap": <path d="M2 9.5L12 5l10 4.5L12 14zM6.5 11.5v4.5c3 2 8 2 11 0v-4.5M22 9.5v5.5" /> break;
        case "heart": <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z" /> break;
        case "gift": <rect x="3.5" y="8" width="17" height="4" rx="1" /><path d="M5 12v8h14v-8M12 8v12M12 8C10.5 4 6.5 4 7.3 6.8 7.8 8 12 8 12 8zM12 8c1.5-4 5.5-4 4.7-1.2C16.2 8 12 8 12 8z" /> break;
        case "child": <circle cx="12" cy="5.5" r="2.5" /><path d="M6.5 11l3-1.5h5l3 1.5M12 9.5v5.5M9 21l3-6 3 6" /> break;
        case "note": <path d="M5 4h10l4 4v12H5zM15 4v4h4M8.5 12.5h7M8.5 16h4.5" /> break;
        case "search": <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /> break;
        case "fold": <path d="M7 4l5 5 5-5M7 20l5-5 5 5" /> break;
        case "wallet": <path d="M4 7h15a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a2 2 0 0 1 2-2h11v3" /><circle cx="16" cy="13.5" r="1.2" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
