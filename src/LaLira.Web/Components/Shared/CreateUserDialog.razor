@inject Texts T

@* The admin's "New user" form. The page passes in the create step, so errors such as an email
   already in use show here and the dialog stays open with what was typed. *@
@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-user-title" @onkeydown="OnKeyDown">
            <h2 id="create-user-title">@T["New user"]</h2>
            <form class="form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>@T["Email address"]</span>
                    <input class="input" type="email" @bind="_email" @bind:event="oninput" @ref="_emailInput" autocomplete="off" spellcheck="false" />
                    <span class="field-hint">
                        @T["They sign in with this."]
                        @(_emailOn ? T["The invite link goes here too."] : T["Email isn't set up, so you'll get the invite link to pass on yourself."])
                    </span>
                </label>
                <label class="field">
                    <span>@T["Display name"]</span>
                    <input class="input" @bind="_name" @bind:event="oninput" autocomplete="off" maxlength="@AppUser.MaxDisplayNameLength" />
                    <span class="field-hint">@T["What {0} calls them. They can change it later.", AppInfo.Name]</span>
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_admin" /> @T["Administrator"]
                </label>
                @foreach (var e in _errors)
                {
                    <div class="field-error">@e</div>
                }
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">@T["Cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_name))">
                        @(_emailOn ? T["Create and send invite"] : T["Create user"])
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record NewUser(string Email, string DisplayName, bool IsAdmin);

    private bool _visible;
    private bool _focusPending;
    private bool _emailOn;
    private bool _busy;
    private string _email = "";
    private string _name = "";
    private bool _admin;
    private IReadOnlyList<string> _errors = [];
    private Func<NewUser, Task<IReadOnlyList<string>>> _create = default!;
    private ElementReference _emailInput;
    private TaskCompletionSource<bool>? _tcs;

    // Resolves to true once create succeeded (it returns no errors), false if canceled.
    public Task<bool> AskAsync(bool emailOn, Func<NewUser, Task<IReadOnlyList<string>>> create)
    {
        _tcs?.TrySetResult(false);
        _emailOn = emailOn;
        _create = create;
        _email = "";
        _name = "";
        _admin = false;
        _errors = [];
        _busy = false;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _emailInput.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Resolve(false);
    }

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true;
        try
        {
            _errors = await _create(new NewUser(_email, _name, _admin));
        }
        finally
        {
            _busy = false;
        }
        if (_errors.Count == 0)
            Resolve(true);
    }

    private void Resolve(bool result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}
