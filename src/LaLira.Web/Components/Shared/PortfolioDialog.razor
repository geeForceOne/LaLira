@inject Texts T

@* Creating a portfolio or changing its name, color and "Others" switch. The page passes the save
   step, so a problem shows here and the dialog keeps what was typed. *@
@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="portfolio-dialog-title" @onkeydown="OnKeyDown">
            <h2 id="portfolio-dialog-title">@(_editing ? T["Edit portfolio"] : T["New portfolio"])</h2>
            <form class="form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>@T["Name"]</span>
                    <input class="input" @bind="_name" @bind:event="oninput" maxlength="@Portfolio.MaxNameLength" placeholder="@T["e.g. ETFs and shares"]" @ref="_first" />
                    @if (!_editing)
                    {
                        <span class="field-hint">@T["Purchases are added on its page."]</span>
                    }
                </label>
                <div class="field">
                    <span>@T["Color"]</span>
                    <div class="color-pick" role="radiogroup" aria-label="@T["Color"]">
                        @foreach (var (key, label) in AccountColors.All)
                        {
                            <button type="button" role="radio" aria-checked="@(_color == key ? "true" : "false")" class="@(_color == key ? "on" : "")"
                                    style="@Format.ColorVar(key)" title="@T[label]" aria-label="@T[label]" @onclick="() => _color = key"></button>
                        }
                    </div>
                </div>
                @* Portfolios are in the overview's chart only with a main currency. *@
                @if (_withOthers)
                {
                    <label class="check">
                        <input type="checkbox" @bind="_inOthers" /> @T["Group under “Others” in the chart"]
                        <span class="check-hint">@T["For small portfolios: the overview chart adds them up into one “Others” band."]</span>
                    </label>
                }
                @if (_error is not null)
                {
                    <div class="field-error">@_error</div>
                }
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">@T["Cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">@(_editing ? T["Save"] : T["Create portfolio"])</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _editing;
    private bool _busy;
    private bool _focusPending;
    private bool _withOthers;
    private string _name = "";
    private string _color = AccountColors.All[^1].Key;
    private bool _inOthers;
    private string? _error;
    private ElementReference _first;
    private Func<PortfolioInput, Task<string?>> _save = default!;
    private TaskCompletionSource<bool>? _tcs;

    // save returns an error to show, or null when saved. Resolves to true once saved.
    // defaultColor: for a new portfolio, the next color no account or portfolio uses yet.
    // withOthers: offer the "Others" switch (with a main currency, when portfolios are in the overview chart).
    public Task<bool> AskAsync(PortfolioInfo? existing, Func<PortfolioInput, Task<string?>> save, string? defaultColor = null, bool withOthers = false)
    {
        _tcs?.TrySetResult(false);
        _editing = existing is not null;
        _name = existing?.Name ?? "";
        _color = existing?.Color ?? defaultColor ?? AccountColors.All[^1].Key;
        _inOthers = existing?.InOthers ?? false;
        _withOthers = withOthers;
        _error = null;
        _busy = false;
        _save = save;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _first.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Resolve(false);
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _error = await _save(new PortfolioInput(_name, _color, _inOthers));
        }
        finally
        {
            _busy = false;
        }
        if (_error is null)
            Resolve(true);
    }

    private void Resolve(bool result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}
