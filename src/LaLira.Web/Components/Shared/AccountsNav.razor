@using System.Security.Claims
@inject OverviewService Overview
@inject PortfolioService Portfolios
@inject Texts T

@* The sidebar's account list with today's balances, then the portfolios. *@
@if (_cards.Count > 0)
{
    <div class="side-label">@T["Accounts"]</div>
    <nav class="side-accounts" aria-label="@T["Accounts"]">
        @foreach (var c in _cards)
        {
            <NavLink href="@($"accounts/{c.Account.Id}")" ActiveClass="active" title="@c.Account.Name">
                <span class="side-account-icon" style="@Format.ColorVar(c.Account.Color)"><Icon Name="@c.Account.Icon" Size="16" /></span>
                <span class="side-account-name">@c.Account.Name</span>
                <span class="side-account-balance @(c.BalanceToday < 0 ? "neg" : "")">@Format.Money(c.BalanceToday, c.Account)</span>
            </NavLink>
        }
    </nav>
}
@if (_portfolios.Count > 0)
{
    <div class="side-label">@T["Portfolios"]</div>
    <nav class="side-accounts" aria-label="@T["Portfolios"]">
        @foreach (var p in _portfolios)
        {
            // The value shows when there are prices for everything held: with a main currency always in
            // it, otherwise when the portfolio has one currency.
            var only = p.Totals.Count == 1 && p.Totals[0] is { HeldCount: > 0, WithoutPrice: 0 } t ? t : null;
            long? value = p.Main is { } m ? (m.Complete && p.HeldCount > 0 ? m.Value : null) : only?.Value;
            <NavLink href="@($"portfolios/{p.Portfolio.Id}")" ActiveClass="active" title="@p.Portfolio.Name">
                <Icon Name="chart" Size="16" />
                <span class="side-account-name">@p.Portfolio.Name</span>
                @if (value is { } v)
                {
                    <span class="side-account-balance">@Format.Money(v, false)</span>
                }
            </NavLink>
        }
    </nav>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<AccountCard> _cards = [];
    private IReadOnlyList<PortfolioCard> _portfolios = [];
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var state = AuthState is null ? null : await AuthState;
        _userId = state?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;
        _cards = (await Overview.GetAsync(_userId, withMain: false)).Accounts;
        _portfolios = await Portfolios.CardsAsync(_userId);
    }
}
