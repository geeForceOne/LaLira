@inject Texts T

@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title"
             @onkeydown="OnKeyDown" tabindex="-1" @ref="_root">
            <h2 id="confirm-title">@_title</h2>
            <p>@_message</p>
            @if (_typed is not null)
            {
                <label class="field">
                    <span>@T["Type {0} to confirm", _typed]</span>
                    <input class="input" @bind="_typedValue" @bind:event="oninput" autocomplete="off" spellcheck="false" @ref="_input" />
                </label>
            }
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">@T["Cancel"]</button>
                <button type="button" class="btn @(_danger ? "btn-danger" : "btn-primary")" disabled="@(!CanConfirm)" @onclick="() => Resolve(true)">@_confirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _focusPending;
    private string _title = "";
    private string _message = "";
    private string _confirmLabel = "";
    private bool _danger;
    private string? _typed;
    private string _typedValue = "";
    private ElementReference _root;
    private ElementReference _input;
    private TaskCompletionSource<bool>? _tcs;

    private bool CanConfirm => _typed is null || string.Equals(_typedValue.Trim(), _typed, StringComparison.CurrentCultureIgnoreCase);

    // Awaited by the caller: `if (!await Ui.Confirm.AskAsync(...)) return;`
    // typedConfirmation: the person has to type this (e.g. the account's name) before confirming.
    public Task<bool> AskAsync(string title, string message, string confirmLabel, bool danger = false, string? typedConfirmation = null)
    {
        _tcs?.TrySetResult(false);
        _title = title;
        _message = message;
        _confirmLabel = confirmLabel;
        _danger = danger;
        _typed = typedConfirmation;
        _typedValue = "";
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await (_typed is null ? _root : _input).FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Resolve(false);
        else if (e.Key == "Enter" && _typed is not null && CanConfirm) Resolve(true);
    }

    private void Resolve(bool result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}
