@page "/account/forgot"
@attribute [AllowAnonymous]
@inject AccountMailService Mail
@inject NavigationManager Nav

<PageTitle>@T["Forgot password"] · @AppInfo.Name</PageTitle>

<div class="auth-form">
    <p class="crumbs"><a href="account/login"><Icon Name="left" Size="14" /> @T["Back to sign in"]</a></p>
    <h1>@T["Forgot password"]</h1>

    @if (!_emailOn)
    {
        <p class="page-sub">@T["This server can't send email, so passwords can't be reset from here. Ask your administrator for a reset link."]</p>
    }
    else if (_sent)
    {
        <div class="notice notice-good" role="status">
            @T["If a user matches what you entered, a reset link is on its way. It expires in {0} hours. Check the spam folder if it doesn't arrive within a few minutes.", (int)AccountMailService.ResetLifespan.TotalHours]
        </div>
    }
    else
    {
        <p class="page-sub">@T["Enter your email address and we'll email you a link to choose a new password."]</p>

        <EditForm Model="Input" method="post" OnSubmit="SendAsync" FormName="forgot-password" class="form">
            <label class="field">
                <span>@T["Email address"]</span>
                <InputText @bind-Value="Input!.Email" type="email" class="input" autocomplete="username" autofocus />
            </label>
            @if (_error is not null)
            {
                <div class="field-error">@_error</div>
            }
            <button type="submit" class="btn btn-primary btn-lg">@T["Send reset link"]</button>
        </EditForm>
    }
</div>

@code {
    private bool _sent;
    private bool _emailOn;
    private string? _error;

    [SupplyParameterFromForm]
    private ForgotInput? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _emailOn = await Mail.EmailConfiguredAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(Input!.Email))
        {
            _error = T["Enter your email address."];
            return;
        }
        await Mail.RequestResetAsync(Input.Email, Nav.BaseUri);
        _sent = true;
    }

    private sealed class ForgotInput
    {
        public string Email { get; set; } = "";
    }
}
