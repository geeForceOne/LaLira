@page "/account/set-password"
@attribute [AllowAnonymous]
@inject AccountMailService Mail
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav
@inject UserActivityService Activity

<PageTitle>@(IsInvite ? T["Welcome"] : T["Choose a new password"]) · @AppInfo.Name</PageTitle>

<div class="auth-form">
    <h1>@(IsInvite ? T["Welcome to {0}", AppInfo.Name] : T["Choose a new password"])</h1>

    @if (_linkError is not null)
    {
        <div class="notice notice-error">@_linkError</div>
        @if (IsInvite)
        {
            <p><a href="account/login">@T["Go to sign in"]</a></p>
        }
        else
        {
            <p><a href="account/forgot">@T["Request a new reset link"]</a></p>
        }
    }
    else
    {
        <p class="page-sub">
            @(IsInvite ? T["Choose a password for your account. You'll be signed in right away."] : T["After this you'll be signed in with the new password."])
        </p>

        @if (_errors.Count > 0)
        {
            <div class="notice notice-error">
                @foreach (var e in _errors)
                {
                    <div>@e</div>
                }
            </div>
        }

        <EditForm Model="Input" method="post" OnSubmit="SetAsync" FormName="set-password" class="form">
            <label class="field">
                <span>@T["New password"]</span>
                <InputText type="password" @bind-Value="Input!.Password" class="input" autocomplete="new-password" autofocus />
                <span class="field-hint">@T["At least 8 characters."]</span>
            </label>
            <label class="field">
                <span>@T["Repeat password"]</span>
                <InputText type="password" @bind-Value="Input!.Confirm" class="input" autocomplete="new-password" />
            </label>
            <button type="submit" class="btn btn-primary btn-lg">@(IsInvite ? T["Set password and sign in"] : T["Save and sign in"])</button>
        </EditForm>
    }
</div>

@code {
    private string? _linkError;
    private readonly List<string> _errors = [];

    [SupplyParameterFromQuery(Name = "user")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    private string? KindParam { get; set; }

    [SupplyParameterFromForm]
    private SetPasswordInput? Input { get; set; }

    private PasswordLinkKind Kind => KindParam == "invite" ? PasswordLinkKind.Invite : PasswordLinkKind.Reset;
    private bool IsInvite => Kind == PasswordLinkKind.Invite;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // Checked on first view too, so an expired link says so before the person types a password.
        _linkError = await Mail.CheckLinkAsync(UserId, Code, Kind);
    }

    private async Task SetAsync()
    {
        if (Input!.Password.Length < 8)
        {
            _errors.Add(T["Use at least {0} characters for the password.", 8]);
            return;
        }
        if (Input.Password != Input.Confirm)
        {
            _errors.Add(T["The passwords don't match."]);
            return;
        }
        var (user, errors) = await Mail.SetPasswordAsync(UserId, Code, Kind, Input.Password, Nav.BaseUri);
        if (user is null)
        {
            _errors.AddRange(errors);
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        await Activity.RecordLoginAsync(user.Id);
        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class SetPasswordInput
    {
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
