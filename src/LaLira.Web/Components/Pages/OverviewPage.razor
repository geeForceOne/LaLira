@page "/"
@inherits AppPage
@inject OverviewService Overview
@inject AccountService Accounts
@inject RecurringService Recurring
@inject SettingsService Settings
@inject PortfolioService Portfolios
@inject IJSRuntime JS

<PageTitle>@T["Overview"] · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <p class="eyebrow">@(_view is null ? "" : Format.DateWithDay(_view.Today))</p>
        <h1>@T["Overview"]</h1>
    </div>
    @* Without accounts the empty state has the button; then "New account" and "New portfolio"
       sit in their section heads. *@
    @if (_view is not null && _view.Accounts.Count == 0 && _portfolios.Count == 0)
    {
        <div class="page-actions">
            <button type="button" class="btn btn-ghost btn-sm" @onclick="NewPortfolioAsync"><Icon Name="plus" Size="15" /> @T["New portfolio"]</button>
        </div>
    }
    else if (_view is not null && (_view.Main?.MonthEnds.Count > 1 || _view.Totals.Any(t => t.MonthEnds.Count > 1)))
    {
        @* One period for every chart on the page, remembered; charts are hidden on phones, so is this. *@
        <div class="page-actions overview-range">
            <div class="bchart-range" role="group" aria-label="@T["Period"]">
                @foreach (var (months, label) in BalanceChart.Ranges)
                {
                    <button type="button" aria-pressed="@(_months == months ? "true" : "false")" @onclick="() => SetMonthsAsync(months)">@T[label]</button>
                }
            </div>
        </div>
    }
</div>

@if (_view is null)
{
    <p class="page-loading">…</p>
}
else
{
    @if (_view.CaughtUp > 0)
    {
        <div class="notice notice-info notice-row" role="status">
            <Icon Name="clock" />
            <span>@T.Plural(_view.CaughtUp, "{0} recurring booking was made late, with its own date, because the app wasn't running on that day.", "{0} recurring bookings were made late, with their own dates, because the app wasn't running on those days.")</span>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => DismissAsync(NoticeKind.CaughtUp)">@T["OK"]</button>
        </div>
    }
    @if (_view.AlertsReached > 0)
    {
        <div class="notice notice-info notice-row" role="status">
            <Icon Name="bell" />
            <span>@T.Plural(_view.AlertsReached, "{0} price alert was reached at the last price update. The details are in your email and on the portfolio page.", "{0} price alerts were reached at the last price update. The details are in your email and on the portfolio page.")</span>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => DismissAsync(NoticeKind.PriceAlert)">@T["OK"]</button>
        </div>
    }

    @if (_view.Accounts.Count == 0)
    {
        <div class="empty">
            <BrandMark Size="72" PlayOnLoad="true" />
            <h2>@T["Start with your first account"]</h2>
            <p>@T["An account has a name, a currency and a starting balance. Then add money in and out, or set up recurring positions that book themselves."]</p>
            <button type="button" class="btn btn-primary" @onclick="NewAccountAsync"><Icon Name="plus" Size="16" /> @T["New account"]</button>
        </div>
        @if (_portfolios.Count > 0)
        {
            <PortfolioCards Cards="_portfolios" OnNew="NewPortfolioAsync" />
        }
    }
    else
    {
        @if (_view.Main is { } m)
        {
            var mainDecimals = _view.Accounts.All(a => a.Account.ShowDecimals);
            <section class="totals totals-main" aria-label="@T["Total in {0}", m.Currency]">
                <div class="total @(m.MonthEnds.Count > 1 ? "with-chart" : "")">
                    <div class="total-figures">
                        <div class="total-label">@T["Total in {0}", m.Currency]</div>
                        <div class="total-value num @(m.Balance < 0 ? "neg" : "")">@Format.Money(m.Balance, mainDecimals)</div>
                        @if (m.HasPortfolios)
                        {
                            <div class="total-split">
                                <span><span class="flow-label">@T["Accounts"]</span> <span class="num">@Format.Money(m.Accounts, mainDecimals)</span></span>
                                <span><span class="flow-label">@T["Portfolios"]</span> <span class="num">@Format.Money(m.Portfolios, mainDecimals)</span></span>
                            </div>
                        }
                        <div class="total-flow">
                            <span title="@T["Money in this month"]"><span class="flow-label">@T["In"]</span> <span class="num">@Format.Money(m.MonthIn, mainDecimals)</span></span>
                            <span title="@T["Money out this month"]"><span class="flow-label">@T["Out"]</span> <span class="num">@Format.Money(m.MonthOut, mainDecimals)</span></span>
                        </div>
                        <div class="total-note muted small">
                            @if (m.RatesDate is { } rd)
                            {
                                <span>@T["Exchange rates of {0}", Format.Date(rd)]</span>
                            }
                            @if (m.Missing.Count > 0)
                            {
                                <span>@T["Without {0}: no exchange rate yet.", string.Join(", ", m.Missing)]</span>
                            }
                        </div>
                    </div>
                    <BalanceChart Points="m.MonthEnds" Bands="Shown(m.Bands)" ShowDecimals="mainDecimals" Months="_months" OnToggleBand="ToggleBandAsync" />
                </div>
            </section>
        }
        <section class="totals" aria-label="@T["Totals"]">
            @foreach (var t in _view.Totals)
            {
                var decimals = _view.Accounts.Where(a => a.Account.Currency == t.Currency).All(a => a.Account.ShowDecimals);
                <div class="total @(t.MonthEnds.Count > 1 ? "with-chart" : "")">
                    <div class="total-figures">
                        <div class="total-label">@T["Total"] <span class="code">@t.Currency</span></div>
                        <div class="total-value num @(t.Balance < 0 ? "neg" : "")">@Format.Money(t.Balance, decimals)</div>
                        <div class="total-flow">
                            <span title="@T["Money in this month"]"><span class="flow-label">@T["In"]</span> <span class="num">@Format.Money(t.MonthIn, decimals)</span></span>
                            <span title="@T["Money out this month"]"><span class="flow-label">@T["Out"]</span> <span class="num">@Format.Money(t.MonthOut, decimals)</span></span>
                        </div>
                    </div>
                    <BalanceChart Points="t.MonthEnds" Bands="Shown(t.Bands)" ShowDecimals="decimals" Months="_months" OnToggleBand="ToggleBandAsync" />
                </div>
            }
        </section>

        <section class="section">
            <div class="section-head">
                <h2>@T["Accounts"]<span class="count">@_view.Accounts.Count</span></h2>
                <div class="section-tools">
                    <span class="muted small">@T["In and out: this month so far"]<span class="drag-hint"> · @T["drag the cards to sort them"]</span></span>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="NewAccountAsync"><Icon Name="plus" Size="15" /> @T["New account"]</button>
                    @if (_portfolios.Count == 0)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="NewPortfolioAsync"><Icon Name="plus" Size="15" /> @T["New portfolio"]</button>
                    }
                </div>
            </div>
            <div class="acct-grid">
                @for (var i = 0; i < _cards.Count; i++)
                {
                    var c = _cards[i];
                    var index = i;
                    // Drag a card to its place; the up/down buttons do the same on phones and from the keyboard.
                    <div class="acct-slot @(_dragId == c.Account.Id ? "dragging" : "")" @key="c.Account.Id"
                         @ondragstart="() => _dragId = c.Account.Id" @ondragenter="() => DragOver(c.Account.Id)"
                         @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondragend="DragEndAsync">
                        <a class="acct-card" href="@($"accounts/{c.Account.Id}")" draggable="true">
                            <div class="acct-top">
                                <span class="acct-name"><span class="acct-icon" style="@Format.ColorVar(c.Account.Color)"><Icon Name="@c.Account.Icon" Size="16" /></span>@c.Account.Name</span>
                                <span class="code">@c.Account.Currency</span>
                            </div>
                            <div class="acct-mid">
                                <div class="acct-balance num @(c.BalanceToday < 0 ? "neg" : "")">@Format.Money(c.BalanceToday, c.Account)</div>
                                <Sparkline Values="c.MonthEndBalances" Color="@c.Account.Color" Label="@T["Balance over the last 12 months"]" />
                            </div>
                            <div class="acct-flow">
                                <span><span class="flow-label">@T["In"]</span> <span class="num">@Format.Money(c.MonthIn, c.Account)</span></span>
                                <span><span class="flow-label">@T["Out"]</span> <span class="num">@Format.Money(c.MonthOut, c.Account)</span></span>
                            </div>
                        </a>
                        @* Move earlier and later, at the right of the In/Out row; on phones the cards stack, so the arrows point up and down. *@
                        @if (index > 0)
                        {
                            <button type="button" class="acct-arrow acct-arrow-earlier" title="@T["Move {0} earlier", c.Account.Name]"
                                    aria-label="@T["Move {0} earlier", c.Account.Name]" @onclick="() => MoveAsync(index, -1)"><Icon Name="left" Size="14" /></button>
                        }
                        @if (index < _cards.Count - 1)
                        {
                            <button type="button" class="acct-arrow acct-arrow-later" title="@T["Move {0} later", c.Account.Name]"
                                    aria-label="@T["Move {0} later", c.Account.Name]" @onclick="() => MoveAsync(index, 1)"><Icon Name="right" Size="14" /></button>
                        }
                    </div>
                }
            </div>
        </section>

        @if (_portfolios.Count > 0)
        {
            <PortfolioCards Cards="_portfolios" OnNew="NewPortfolioAsync" />
        }

        <section class="section">
            <div class="section-head">
                <h2>@T["Coming up"]</h2>
                <a class="btn btn-ghost btn-sm" href="recurring">@T["Recurring positions"] <Icon Name="right" Size="14" /></a>
            </div>
            @if (_upcoming.Count == 0)
            {
                <p class="muted">@T["No recurring bookings in the next 31 days."] <a href="recurring">@T["Set one up"]</a></p>
            }
            else
            {
                <table class="table upcoming-table">
                    <tbody>
                        @foreach (var u in _upcoming)
                        {
                            <tr>
                                <td class="nowrap num muted">@Format.Date(u.Date)</td>
                                <td>
                                    <div>@u.Description</div>
                                    <div class="muted small">@u.AccountName</div>
                                </td>
                                <td class="num amount">@Format.Money(u.Amount, u.ShowDecimals) <span class="code">@u.Currency</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
}

<AccountDialog @ref="_accountDialog" />

@code {
    private OverviewView? _view;
    private List<AccountCard> _cards = [];
    private int? _dragId;
    private List<int> _orderBeforeDrag = [];
    private IReadOnlyList<UpcomingBooking> _upcoming = [];
    private IReadOnlyList<PortfolioCard> _portfolios = [];
    private AccountDialog _accountDialog = default!;
    private int _months = OverviewService.DefaultMonths;

    // The bands switched off from a legend, by key; changed here first so a click shows at once.
    private HashSet<string> _hidden = [];

    private DotNetObjectReference<OverviewPage>? _self;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("lalira.onVisible", _self); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    // Back on this tab: everything loaded again, as it may have changed elsewhere (another tab,
    // the daily price update). Not while something is being saved or a card dragged.
    [JSInvokable]
    public async Task OnVisibleAsync()
    {
        if (Busy || _dragId is not null) return;
        await LoadAsync();
        await Ui.RefreshAccountsAsync();
        StateHasChanged();
    }

    public override void Dispose()
    {
        _self?.Dispose();
        base.Dispose();
    }

    private async Task LoadAsync()
    {
        var userId = await UserIdAsync();
        _view = await Overview.GetAsync(userId, PageToken);
        _months = _view.Months;
        _hidden = (_view.Main?.Bands ?? []).Concat(_view.Totals.SelectMany(t => t.Bands)).Where(b => b.Hidden).Select(b => b.Key).ToHashSet();
        _cards = _view.Accounts.ToList();
        _upcoming = await Recurring.UpcomingAsync(userId, 31, 8, PageToken);
        _portfolios = await Portfolios.CardsAsync(userId, PageToken);
    }

    // A name is all a portfolio needs; the purchases are added on its page.
    private async Task NewPortfolioAsync()
    {
        var name = await Ui.Prompt.AskAsync(T["New portfolio"], T["Name"], "", T["Create portfolio"], hint: T["For example “ETFs and shares”. Purchases are added on its page."]);
        if (name is null) return;
        var userId = await UserIdAsync();
        PortfolioInfo? created = null;
        if (!await RunAsync(async () => created = await Portfolios.CreateAsync(userId, name, PageToken)) || created is null)
            return;
        await Ui.RefreshAccountsAsync();
        Nav.NavigateTo($"portfolios/{created.Id}");
    }

    private async Task NewAccountAsync()
    {
        var userId = await UserIdAsync();
        var today = _view?.Today ?? DateOnly.FromDateTime(DateTime.Today);
        var regional = new System.Globalization.RegionInfo(T.Format.Name).ISOCurrencySymbol;
        var currency = _view?.Accounts.FirstOrDefault()?.Account.Currency ?? (Currencies.IsKnown(regional) ? regional : "CHF");
        AccountInfo? created = null;
        var color = AccountColors.Next(_cards.Select(c => (string?)c.Account.Color));
        var ok = await _accountDialog.AskAsync(null, today, currency, defaultColor: color, save: async input =>
        {
            try
            {
                created = await Accounts.CreateAsync(userId, input, PageToken);
                return null;
            }
            catch (InputException ex)
            {
                return ErrorText(ex);
            }
        });
        if (!ok || created is null) return;
        Ui.Toast.Success(T["Account {0} created.", created.Name]);
        await Ui.RefreshAccountsAsync();
        Nav.NavigateTo($"accounts/{created.Id}");
    }

    // While dragging, the cards make room as the pointer passes over them; the order is saved on release.
    private void DragOver(int targetId)
    {
        if (_dragId is not { } dragId || dragId == targetId) return;
        if (_orderBeforeDrag.Count == 0)
            _orderBeforeDrag = _cards.Select(c => c.Account.Id).ToList();
        var from = _cards.FindIndex(c => c.Account.Id == dragId);
        var to = _cards.FindIndex(c => c.Account.Id == targetId);
        if (from < 0 || to < 0) return;
        var card = _cards[from];
        _cards.RemoveAt(from);
        _cards.Insert(to, card);
    }

    private async Task DragEndAsync()
    {
        _dragId = null;
        var before = _orderBeforeDrag;
        _orderBeforeDrag = [];
        if (before.Count > 0 && !before.SequenceEqual(_cards.Select(c => c.Account.Id)))
            await SaveOrderAsync();
    }

    private async Task MoveAsync(int index, int by)
    {
        var to = index + by;
        if (to < 0 || to >= _cards.Count) return;
        (_cards[index], _cards[to]) = (_cards[to], _cards[index]);
        await SaveOrderAsync();
    }

    private async Task SaveOrderAsync()
    {
        var userId = await UserIdAsync();
        var ids = _cards.Select(c => c.Account.Id).ToList();
        if (await RunAsync(() => Accounts.ReorderAsync(userId, ids, PageToken)))
            await Ui.RefreshAccountsAsync();
        else
            await LoadAsync();
    }

    private IReadOnlyList<ChartBand> Shown(IReadOnlyList<ChartBand> bands) =>
        bands.Select(b => b with { Hidden = _hidden.Contains(b.Key) }).ToList();

    private async Task ToggleBandAsync(string key)
    {
        var hide = _hidden.Add(key);
        if (!hide)
            _hidden.Remove(key);
        var userId = await UserIdAsync();
        await RunAsync(() => Overview.SetHiddenAsync(userId, key, hide, PageToken));
    }

    private async Task SetMonthsAsync(int months)
    {
        _months = months;
        var userId = await UserIdAsync();
        await RunAsync(() => Overview.SetMonthsAsync(userId, months, PageToken));
    }

    private async Task DismissAsync(NoticeKind kind)
    {
        await Overview.DismissAsync(await UserIdAsync(), kind, PageToken);
        await LoadAsync();
    }
}
