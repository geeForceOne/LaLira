@page "/release-notes"
@attribute [AllowAnonymous]
@inject Texts T

<PageTitle>@T["Release notes"] · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>@T["Release notes"]</h1>
    </div>
</div>

<article class="release-notes">
    @((MarkupString)ReleaseNotes.Html)
</article>
